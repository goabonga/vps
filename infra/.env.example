# OVHcloud API: ONE method is enough.
# 1. OAuth2 service account (written by scripts/bootstrap.sh)
OVH_CLIENT_ID=
OVH_CLIENT_SECRET=
# 2. Short-lived access token (bootstrap only, usually passed in the environment)
# OVH_ACCESS_TOKEN=
# 3. Classic API keys
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=

# Id of the Public Cloud project of the bootstrap (not committed)
OVH_PROJECT_ID=

# Object Storage OVHcloud (state)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
